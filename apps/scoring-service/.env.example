# apps/scoring-service — validated at boot (src/config/env.ts).
NODE_ENV=development
PORT=4003
DATABASE_URL=postgresql://user:password@localhost:5432/useframe
REDIS_URL=redis://localhost:6379
CLIENT_URL=http://localhost:3000
# Same value as apps/server INTERNAL_SERVICE_SECRET (min 16 chars).
INTERNAL_SERVICE_SECRET=

# At least one of these two is required.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
