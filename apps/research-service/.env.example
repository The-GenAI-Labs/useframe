# Research corpus additions; preserve your existing application settings.
EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-4
EMBEDDING_DIMS=1024
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-v4.0-fast
RERANK_MIN_SCORE=0.15
PER_AREA_TOP_K=5
RRF_K=60
DENSE_CANDIDATES=40
SPARSE_CANDIDATES=40
FUSED_CANDIDATES=30
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
INTERNAL_SERVICE_SECRET=replace-with-shared-internal-secret
ORCHESTRATOR_URL=http://localhost:4001
RESEARCH_MOCK=false

# Use the existing Redis deployment. Omit REDIS_URL to bypass the exact tier and counters.
# REDIS_URL=redis://localhost:6379
CACHE_SIM_HIGH=0.97
CACHE_SIM_LOW=0.88
CACHE_SEMANTIC_CANDIDATES=3
CACHE_DEDUP_SIM=0.99
CACHE_EXACT_TTL_SECONDS=2592000
JEV_CACHE_ACCEPT_THRESHOLD=0.75
# Set shadow first to collect evidence; on requires >=200 comparable decisions and >=90% agreement.
JEV_MODE_RETRIEVAL_CACHE_VERIFY=off
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0
JEV_TIMEOUT_MS=1000