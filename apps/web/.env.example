# apps/web — only public configuration belongs here; the browser bundle reads these.
NEXT_PUBLIC_API_SERVICE_URL=http://localhost:4000
NEXT_PUBLIC_ORCHESTRATOR_URL=http://localhost:4001
# Cloudflare Turnstile site key (public). The secret key lives in apps/server only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Optional: set to allow search engines to index this deployment (see src/lib/metadata.ts).
# SITE_INDEXING_ENABLED=true
