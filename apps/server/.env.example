# Research corpus addition; preserve existing API settings.
INTERNAL_SERVICE_SECRET=replace-with-shared-internal-secret
# Deploy service (apps/deploy-service); uses INTERNAL_SERVICE_SECRET above.
DEPLOY_SERVICE_URL=http://localhost:4005
DEPLOY_USER_RATE_LIMIT_PER_HOUR=10
CUSTOM_DOMAIN_MAX_ADD_PER_HOUR=5

# Intake brief (modules/briefs). All optional; defaults shown.
BRIEF_MAX_OPEN_DRAFTS=5
BRIEF_DRAFT_TTL_DAYS=30
BRIEF_PREFILL_MAX_CHARS=20000
BRIEF_PREFILL_TIMEOUT_MS=25000
BRIEF_DOC_MAX_BYTES=10485760
BRIEF_LOGO_MAX_BYTES=2097152
BRIEF_RATE_CREATE_PER_HOUR=10
BRIEF_RATE_PREFILL_PER_HOUR=10
BRIEF_RATE_PREFILL_URL_PER_HOUR=3

# Media library (modules/media). Optional until media is used: media routes answer 503
# while the bucket token or the signing secret is unset.
MEDIA_R2_BUCKET=useframe-media
# R2 token: Object Read & Write on useframe-media only.
MEDIA_R2_ACCESS_KEY_ID=
MEDIA_R2_SECRET_ACCESS_KEY=
# Defaults to https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
MEDIA_R2_ENDPOINT=
CLOUDFLARE_ACCOUNT_ID=
# 32+ random bytes; signs /media/:assetId/:role URLs.
MEDIA_SIGNING_SECRET=
MEDIA_SIGNED_URL_TTL_SECONDS=3600
# This API's public origin (serves /media/...).
MEDIA_PUBLIC_BASE_URL=http://localhost:4000
# Extra origins allowed to read /media (CLIENT_URL and FRONTEND_URL always are), comma-separated.
MEDIA_CORS_ORIGINS=
MEDIA_FREE_MAX_IMAGES=10
MEDIA_FREE_MAX_IMAGE_BYTES=5242880
MEDIA_FREE_TOTAL_BYTES=104857600
MEDIA_PAID_MAX_IMAGES=100
MEDIA_PAID_MAX_IMAGE_BYTES=20971520
MEDIA_PAID_MAX_VIDEOS=5
MEDIA_PAID_MAX_VIDEO_BYTES=157286400
MEDIA_PAID_TOTAL_BYTES=5368709120
MEDIA_MAX_AUTOPLAY_VIDEOS_PER_PAGE=3
