# apps/deploy-service — every variable is validated at boot (src/config/schema.ts).
NODE_ENV=development
PORT=4005
DATABASE_URL=
REDIS_URL=redis://localhost:6379
# Same value as apps/server INTERNAL_SERVICE_SECRET (min 16 chars).
INTERNAL_SERVICE_SECRET=

# Generated sites live on *.<SITES_BASE_DOMAIN>. Never hard-code the domain elsewhere.
SITES_BASE_DOMAIN=useframe.in
# Same list as the Worker's RESERVED_HOSTS and Terraform bypass_hosts.
SITES_RESERVED_HOSTS=useframe.in,www.useframe.in,api.useframe.in

CLOUDFLARE_ACCOUNT_ID=
# Runtime token: Account > Workers KV Storage: Edit, Zone > Zone: Read. Never the admin token.
CLOUDFLARE_API_TOKEN=
# Used from Stage 2 (custom domains); optional now.
CLOUDFLARE_ZONE_ID=
# `terraform output kv_namespace_id`
SITES_KV_NAMESPACE_ID=

SITES_R2_BUCKET=useframe-sites
# R2 S3 token scoped to Object Read & Write on the sites bucket only.
SITES_R2_ACCESS_KEY_ID=
SITES_R2_SECRET_ACCESS_KEY=
# Defaults to https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
SITES_R2_ENDPOINT=

# Media library (read-only token on useframe-media). Needed only to deploy sites that use media;
# such deploys fail with a clear message while these are unset.
MEDIA_R2_BUCKET=useframe-media
MEDIA_R2_READ_ACCESS_KEY_ID=
MEDIA_R2_READ_SECRET_ACCESS_KEY=
# Defaults to https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
MEDIA_R2_ENDPOINT=

DEPLOY_RETAIN_COUNT=10
DEPLOY_MAX_FILES=5000
DEPLOY_MAX_TOTAL_MB=100
DEPLOY_INSTALL_TIMEOUT_MS=300000
DEPLOY_BUILD_TIMEOUT_MS=480000
DEPLOY_BUILD_CONCURRENCY=2
DEPLOY_ACTIVATION_PROBE_MS=150000
DEPLOY_REAPER_STUCK_MINUTES=30
# Defaults to /work in production and <os tmpdir>/useframe-deploy elsewhere.
DEPLOY_WORK_DIR=
DEPLOY_BUILD_UID=10002
DEPLOY_BUILD_GID=10002
# setpriv (default, Linux) | none (dev only; refused when NODE_ENV=production).
DEPLOY_BUILD_ISOLATION=setpriv
# node_modules templates baked into the image; absent locally, so installs run.
DEPLOY_NODE_MODULES_TEMPLATES=/opt/templates
# true = enqueue the post-deploy MAIN validation run (needs the worker's GCS setup).
DEPLOY_ENQUEUE_VALIDATION=false

# Spike only (pnpm spike): e.g. https://useframe.in/ to confirm pass-through.
SPIKE_RESERVED_HOST_URL=

# Stage 2 — custom domains. OFF until the Stage 1 spike and spike:domains pass.
CUSTOM_DOMAINS_ENABLED=false
# Defaults to cname.<SITES_BASE_DOMAIN>; must match the Terraform output edge_cname_target.
SITES_EDGE_CNAME_TARGET=
CUSTOM_DOMAIN_CAPACITY_LIMIT=100
# Comma-separated extra blocked domains (their subdomains are blocked too).
CUSTOM_DOMAIN_BLOCKLIST=
CUSTOM_DOMAIN_OWNERSHIP_WINDOW_HOURS=72
CUSTOM_DOMAIN_ROUTING_WINDOW_DAYS=7
# Explicit public resolvers for TXT/CNAME checks (never the cluster resolver).
DNS_RESOLVERS=1.1.1.1,8.8.8.8
# spike:domains and the gated e2e test only.
SPIKE_CUSTOM_HOSTNAME=
