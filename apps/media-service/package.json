{
  "name": "@useframe/media-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx --watch src/worker.ts",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node dist/worker.js",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "media:gc": "tsx src/cli/gc.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1144.0",
    "@aws-sdk/lib-storage": "3.1144.0",
    "@repo/events": "workspace:*",
    "@repo/schemas": "workspace:*",
    "@useframe/db": "workspace:*",
    "bullmq": "^5.28.0",
    "dotenv": "^16.6.1",
    "ioredis": "^5.4.1",
    "sharp": "^0.34.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@useframe/typescript-config": "workspace:*",
    "tsc-alias": "1.9.7",
    "tsx": "^4.22.1",
    "typescript": "5.9.2",
    "vitest": "^2.1.9"
  }
}
