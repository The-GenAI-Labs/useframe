# apps/media-service — every variable is validated at boot (src/config/schema.ts).
NODE_ENV=development
# Health listener port (optional; the worker has no other HTTP).
HEALTH_PORT=
DATABASE_URL=
REDIS_URL=redis://localhost:6379

# R2 token: Object Read & Write on useframe-media only.
MEDIA_R2_BUCKET=useframe-media
MEDIA_R2_ACCESS_KEY_ID=
MEDIA_R2_SECRET_ACCESS_KEY=
# Set one of these two.
MEDIA_R2_ENDPOINT=
CLOUDFLARE_ACCOUNT_ID=

# Scratch space; defaults to /work in production and <os tmpdir>/useframe-media elsewhere.
MEDIA_WORK_DIR=
MEDIA_PROCESS_CONCURRENCY=2
MEDIA_FFMPEG_TIMEOUT_MS=180000
MEDIA_FFMPEG_THREADS=2
MEDIA_MAX_INPUT_PIXELS=60000000
MEDIA_MAX_VIDEO_SECONDS=60
# Hard ceilings for any original, uploaded or generated.
MEDIA_PAID_MAX_IMAGE_BYTES=20971520
MEDIA_PAID_MAX_VIDEO_BYTES=157286400

# Vision descriptions via orchestrator-service (/internal/media/describe).
MEDIA_DESCRIBE_ENABLED=true
MEDIA_DESCRIBE_TIMEOUT_MS=30000
ORCHESTRATOR_URL=http://localhost:4001
# Same value as orchestrator-service INTERNAL_SERVICE_SECRET (min 16 chars).
INTERNAL_SERVICE_SECRET=

# AI media: Site Blueprint + creative pipeline (docs/media-ai.md). Off by default.
# server, orchestrator-service and media-service all read this block; keep them identical.
MEDIA_ENABLED=false
# Credits per generated image, per video second and per Site Blueprint call.
# Required in production once MEDIA_ENABLED=true; 1 elsewhere when unset.
MEDIA_CREDIT_IMAGE=
MEDIA_CREDIT_VIDEO_PER_SECOND=
MEDIA_CREDIT_BLUEPRINT=
# images:videos per budget tier, plus hard caps.
MEDIA_BUDGET_IMAGES_ONLY=8:0
MEDIA_BUDGET_LIGHT=4:1
MEDIA_BUDGET_STANDARD=8:3
MEDIA_BUDGET_RICH=14:6
MEDIA_HARD_MAX_IMAGES=24
MEDIA_HARD_MAX_VIDEOS=10
MEDIA_HARD_MAX_GENERATED_ASSETS=60
VIDEO_MIN_SECONDS=5
VIDEO_MAX_SECONDS=10
# Circuit breaker: provider spend over the last 24 h above this pauses AI media. Empty = no cap.
MEDIA_DAILY_COST_CAP_USD=
# Provider cost estimates in USD, used when a provider does not report cost.
MEDIA_COST_IMAGE_USD=0.25
MEDIA_COST_VIDEO_USD_PER_SECOND=0.08
MEDIA_COST_LLM_CALL_USD=0.05
MEDIA_COST_BLUEPRINT_USD=0.4

# fake = no provider calls or spend. live needs OPENAI_API_KEY, RUNWARE_API_KEY and INTERNAL_SERVICE_SECRET.
MEDIA_AI_PROVIDER_MODE=fake
# OPENAI_API_KEY=replace-with-provider-key
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_IMAGE_QUALITY=high
VIDEO_PROVIDER=runware
# RUNWARE_API_KEY=replace-with-provider-key
MEDIA_VIDEO_MODEL=minimax:h3@max
MEDIA_VIDEO_RESOLUTION=768p
# Longest a single video render may take before the item falls back to a still.
MEDIA_VIDEO_TIMEOUT_S=600
MEDIA_VIDEO_PROMPT_EXPANSION=disabled
MEDIA_VIDEO_PROMPT_MAX_CHARS=3000
# Concurrent provider calls across all media-service replicas (Redis leases).
MEDIA_IMAGE_CONCURRENCY=3
MEDIA_VIDEO_CONCURRENCY=2
# https hosts provider result downloads may come from, comma-separated.
MEDIA_PROVIDER_HOST_ALLOWLIST=vm.runware.ai,im.runware.ai
