# apps/media-service — every variable is validated at boot (src/config/schema.ts).
NODE_ENV=development
# Health listener port (optional; the worker has no other HTTP).
HEALTH_PORT=
DATABASE_URL=
REDIS_URL=redis://localhost:6379

# R2 token: Object Read & Write on useframe-media only.
MEDIA_R2_BUCKET=useframe-media
MEDIA_R2_ACCESS_KEY_ID=
MEDIA_R2_SECRET_ACCESS_KEY=
# Set one of these two.
MEDIA_R2_ENDPOINT=
CLOUDFLARE_ACCOUNT_ID=

# Scratch space; defaults to /work in production and <os tmpdir>/useframe-media elsewhere.
MEDIA_WORK_DIR=
MEDIA_PROCESS_CONCURRENCY=2
MEDIA_FFMPEG_TIMEOUT_MS=180000
MEDIA_FFMPEG_THREADS=2
MEDIA_MAX_INPUT_PIXELS=60000000
MEDIA_MAX_VIDEO_SECONDS=60
# Hard ceilings for any original, uploaded or generated.
MEDIA_PAID_MAX_IMAGE_BYTES=20971520
MEDIA_PAID_MAX_VIDEO_BYTES=157286400

# Vision descriptions via orchestrator-service (/internal/media/describe).
MEDIA_DESCRIBE_ENABLED=true
MEDIA_DESCRIBE_TIMEOUT_MS=30000
ORCHESTRATOR_URL=http://localhost:4001
# Same value as orchestrator-service INTERNAL_SERVICE_SECRET (min 16 chars).
INTERNAL_SERVICE_SECRET=
