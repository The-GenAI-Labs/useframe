# Research corpus addition; preserve existing orchestrator settings.
INTERNAL_SERVICE_SECRET=replace-with-shared-internal-secret

# Project-scoped chat. deepseek-v4-flash maps to provider model deepseek-chat.
# DEEPSEEK_API_KEY=replace-with-provider-key
CHAT_MODEL=deepseek-v4-flash
OFF_TOPIC_THRESHOLD=0.65
MAX_HISTORY_MESSAGES=10
# Default off. Start rollout in shadow; enable on only after labeled evaluation.
JEV_MODE_CHAT_SCOPE=off
# TYPESAFE_API_KEY=replace-with-typesafe-key
JEV_MODEL=jev-1.13.0
JEV_TIMEOUT_MS=1000

# Intake brief pre-fill/resolver (routes/brief.route.ts). Optional; defaults shown.
BRIEF_PREFILL_MAX_CHARS=20000
BRIEF_PREFILL_TIMEOUT_MS=25000
BRIEF_DOC_MAX_BYTES=10485760
