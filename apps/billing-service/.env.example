# apps/billing-service — validated at boot (src/config/env.ts).
NODE_ENV=development
PORT=4002
DATABASE_URL=postgresql://user:password@localhost:5432/useframe
REDIS_URL=redis://localhost:6379
CLIENT_URL=http://localhost:3000

# Razorpay dashboard > Settings > API Keys. Use test keys locally.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay dashboard > Webhooks: the secret you set on the webhook that points at this service.
RAZORPAY_WEBHOOK_SECRET=
