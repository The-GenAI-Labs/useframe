# Copy to tests/.env.test. Every value below is a local placeholder, not a secret.

# Where the suites point. Defaults are the dedicated test stack (ports +100 from
# the normal dev stack), which Playwright starts on demand.
BASE_URL=http://localhost:3100
API_URL=http://localhost:4100
ORCHESTRATOR_URL=http://localhost:4101
BILLING_URL=http://localhost:4102

# Test database and Redis. Local: `docker compose -f tests/docker-compose.yml up -d`.
# Never point these at a shared database you did not create.
DATABASE_URL=postgresql://useframe:useframe@127.0.0.1:55432/useframe_test
REDIS_URL=redis://127.0.0.1:56379

# Comma-separated extra hostnames the suites may target (staging only).
# localhost and 127.0.0.1 are always allowed. Never list a production host.
ALLOWED_TARGET_HOSTS=

# Test accounts. UseFrame has no password login: the suites sign these users in
# by writing a one-time magic-link token to the test database.
TEST_USER_EMAIL=e2e-free@useframe.test
TEST_OTHER_USER_EMAIL=e2e-other@useframe.test
