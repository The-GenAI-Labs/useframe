# Research corpus additions; preserve your existing application settings.
EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-4
EMBEDDING_DIMS=1024
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-v4.0-fast
RERANK_MIN_SCORE=0.15
PER_AREA_TOP_K=5
RRF_K=60
DENSE_CANDIDATES=40
SPARSE_CANDIDATES=40
FUSED_CANDIDATES=30
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
# Optional until corpus ingestion is enabled; uncomment and fill before use.
# GCP_PROJECT_ID=your-project
# GCS_RESEARCH_CORPUS_BUCKET=your-private-corpus-bucket
# CORPUS_PUBSUB_TOPIC=corpus-events
# CORPUS_PUBSUB_SUBSCRIPTION=corpus-worker
INTERNAL_SERVICE_SECRET=replace-with-shared-internal-secret
ORCHESTRATOR_URL=http://localhost:4001
DATABASE_URL=postgresql://user:password@localhost:5432/useframe
REDIS_URL=redis://localhost:6379
