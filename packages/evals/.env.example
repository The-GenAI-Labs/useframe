# Research corpus additions; preserve your existing application settings.
EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-4
EMBEDDING_DIMS=1024
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-v4.0-fast
RERANK_MIN_SCORE=0.15
PER_AREA_TOP_K=5
RRF_K=60
DENSE_CANDIDATES=40
SPARSE_CANDIDATES=40
FUSED_CANDIDATES=30
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
INTERNAL_SERVICE_SECRET=replace-with-shared-internal-secret
ORCHESTRATOR_URL=http://localhost:4001
DATABASE_URL=postgresql://user:password@localhost:5432/useframe

# Optional live chat-scope evaluation; match orchestrator policy settings.
# TYPESAFE_API_KEY=replace-with-typesafe-key
JEV_MODEL=jev-1.13.0
JEV_TIMEOUT_MS=1000
OFF_TOPIC_THRESHOLD=0.65