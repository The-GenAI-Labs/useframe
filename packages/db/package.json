{
  "name": "@useframe/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "seed": "tsx prisma/seed.ts",
    "test": "vitest run",
    "build": "prisma generate && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@ai-sdk/openai": "^1.0.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@repo/schemas": "workspace:*",
    "ai": "^4.0.0",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.43.1",
    "pg": "^8.21.0",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/pg": "^8.20.0",
    "@useframe/typescript-config": "workspace:*",
    "drizzle-kit": "^0.31.1",
    "prisma": "^7.8.0",
    "tsx": "^4.22.1",
    "typescript": "5.9.2",
    "vitest": "^2.1.9"
  }
}
