generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentPurpose {
  SUBSCRIPTION
  CREDIT_TOPUP
}

enum CreditTxnType {
  RECURRING_GRANT
  PURCHASED
  SPEND
  REFUND
  ADJUSTMENT
}

enum ChatRole {
  USER
  ASSISTANT
  SYSTEM
}

enum ProjectStatus {
  DRAFT
  GENERATING
  READY
  DEPLOYING
  LIVE
  FAILED
}

enum DeploymentStatus {
  QUEUED
  BUILDING
  UPLOADING
  DNS_PROVISIONING
  LIVE
  FAILED
  ROLLED_BACK
}

enum PipelineStage {
  RETRIEVAL
  SPECIALISTS
  CRITIQUE
  REFINEMENT
  SYNTHESIS
  COPY
  SEO
  COMPLETE
  FAILED
  SCAN
  RESEARCH
  GENERATE
  DEPLOY
}

enum OAuthProvider {
  GOOGLE
  GITHUB
  EMAIL
}

enum DomainStatus {
  PENDING
  VERIFYING
  ACTIVE
  FAILED
}

enum NicheCategory {
  EDTECH
  HEALTH_WELLNESS
  FINTECH
  SAAS_B2B
  ECOMMERCE
  FOOD_LIFESTYLE
  FITNESS
  LUXURY
  MEDITATION
  KIDS
  OTHER
}

enum CopyFramework {
  AIDA
  PAS
  FAB
  PASTOR
}

enum SiteType {
  SINGLE_PAGE
  MULTI_PAGE
}

enum PageType {
  HOME
  ABOUT
  CONTACT
  PRICING
  PRODUCT
  RESEARCH
  DEMO
}

enum ResearchKind {
  ARTICLE
  CASE_STUDY
}

enum ResearchCategory {
  COLOR_PSYCHOLOGY
  TYPOGRAPHY
  SCREEN_TIME
  LAYOUT
  CONVERSION
  ACCESSIBILITY
  AGE_GROUP
  INDUSTRY
  OTHER
}

enum ScanType {
  COMPETITOR
  OWN_SITE
}

enum ScanStatus {
  QUEUED
  RENDERING
  EXTRACTING
  ANALYZING
  DONE
  FAILED
}

enum ProjectInputType {
  FROM_SCRATCH
  FROM_COMPETITOR
  FROM_OWN_SITE
}

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  phone           String?    @unique
  name            String?
  image           String?
  emailVerified   DateTime?
  displayName     String?
  avatarUrl       String?
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  credentials             UserCredential?
  identities              UserIdentity[]
  refreshTokens           RefreshToken[]
  sessions                UserSession[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  phoneOtps               PhoneOtp[]
  subscription            Subscription?
  payments                Payment[]
  creditBalance           CreditBalance?
  creditTransactions      CreditTransaction[]
  projects                Project[]
  conversations           Conversation[]
  deployments             Deployment[]
  usageLogs               UsageLog[]
  competitorScans         CompetitorScan[]
  authAccounts            Account[]
  authSessions            Session[]

  @@index([deletedAt])
  @@map("users")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
  @@map("auth_accounts")
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
  @@map("auth_verification_tokens")
}

model UserCredential {
  userId            String   @id
  passwordHash      String
  passwordChangedAt DateTime @default(now())
  requiresReset     Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_credentials")
}

model UserIdentity {
  id              String        @id @default(cuid())
  userId          String
  provider        OAuthProvider
  providerUserId  String
  emailAtProvider String?
  createdAt       DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("user_identities")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  familyId  String
  parentId  String?
  userAgent String?
  ip        String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   RefreshToken?  @relation("TokenLineage", fields: [parentId], references: [id])
  children RefreshToken[] @relation("TokenLineage")
  sessions UserSession[]

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model UserSession {
  id             String    @id @default(cuid())
  userId         String
  refreshTokenId String?
  deviceName     String?
  userAgent      String?
  ip             String?
  lastActiveAt   DateTime  @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken RefreshToken? @relation(fields: [refreshTokenId], references: [id])

  @@index([userId])
  @@map("user_sessions")
}

model EmailVerificationToken {
  id         String    @id @default(cuid())
  userId     String
  email      String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model PhoneOtp {
  id          String    @id @default(cuid())
  userId      String
  phone       String
  codeHash    String
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("phone_otps")
}

model Plan {
  id                        String   @id @default(cuid())
  name                      String
  slug                      String   @unique
  description               String?
  rank                      Int
  priceMonthly              Int      @default(0)
  priceYearly               Int      @default(0)
  currency                  String   @default("USD")
  creditAllowance           Int      @default(0)
  monthlyGenerationQuota    Int?
  requiresPhoneVerification Boolean  @default(false)
  features                  Json     @default("{}")
  isActive                  Boolean  @default(true)
  createdAt                 DateTime @default(now())

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                     String             @id @default(cuid())
  userId                 String             @unique
  planId                 String
  status                 SubscriptionStatus @default(ACTIVE)
  billingInterval        BillingInterval    @default(MONTHLY)
  currentPeriodStart     DateTime
  currentPeriodEnd       DateTime
  cancelAtPeriodEnd      Boolean            @default(false)
  providerSubscriptionId String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan     Plan      @relation(fields: [planId], references: [id])
  payments Payment[]

  @@index([planId])
  @@map("subscriptions")
}

model Payment {
  id                String         @id @default(cuid())
  userId            String
  purpose           PaymentPurpose
  subscriptionId    String?
  amount            Int
  currency          String         @default("USD")
  status            PaymentStatus  @default(PENDING)
  provider          String         @default("stripe")
  providerOrderId   String         @unique
  providerPaymentId String?
  paymentMethod     String?
  capturedAt        DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription       Subscription?       @relation(fields: [subscriptionId], references: [id])
  creditTransactions CreditTransaction[]

  @@index([userId])
  @@map("payments")
}

model WebhookEvent {
  id          String    @id @default(cuid())
  eventId     String    @unique
  eventType   String
  provider    String    @default("stripe")
  payload     Json
  processed   Boolean   @default(false)
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@map("webhook_events")
}

model CreditBalance {
  userId      String   @id
  balance     Int      @default(0)
  periodStart DateTime @default(now())
  periodEnd   DateTime
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("credit_balances")
}

model CreditTransaction {
  id           String        @id @default(cuid())
  userId       String
  delta        Int
  type         CreditTxnType
  reason       String
  balanceAfter Int
  refId        String?
  paymentId    String?
  expiresAt    DateTime?
  createdAt    DateTime      @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment Payment? @relation(fields: [paymentId], references: [id])

  @@index([userId, createdAt])
  @@map("credit_transactions")
}

model Project {
  id               String           @id @default(cuid())
  userId           String
  name             String
  slug             String           @unique
  startupIdea      String
  niche            NicheCategory    @default(OTHER)
  targetAudience   String
  status           ProjectStatus    @default(DRAFT)
  inputType        ProjectInputType @default(FROM_SCRATCH)
  sourceUrl        String?
  docsKey          String?
  description      String?
  logoUrl          String?
  currentVersionId String?
  pinned           Boolean          @default(false)
  deletedAt        DateTime?
  archivedAt       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions        ProjectVersion[]
  pages           Page[]
  conversations   Conversation[]
  deployments     Deployment[]
  customDomain    CustomDomain?
  pipelineLogs    PipelineLog[]
  analytics       ProjectAnalytics?
  pageAnalytics   PageAnalytics[]
  researchReport  ResearchReport?
  competitorScans CompetitorScan[]

  @@index([userId])
  @@index([status])
  @@index([deletedAt])
  @@index([userId, deletedAt])
  @@index([userId, pinned])
  @@map("projects")
}

model ProjectVersion {
  id                 String   @id @default(cuid())
  projectId          String
  versionNumber      Int
  label              String?
  siteType           SiteType @default(MULTI_PAGE)
  seo                Json     @default("{}")
  parentVersionId    String?
  createdByMessageId String?
  snapshot           Json
  createdAt          DateTime @default(now())

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pages       Page[]
  deployments Deployment[]

  @@unique([projectId, versionNumber])
  @@index([projectId])
  @@map("project_versions")
}

model Page {
  id          String    @id @default(cuid())
  projectId   String
  versionId   String
  type        PageType  @default(HOME)
  slug        String
  title       String
  sections    Json
  seo         Json?
  ogImageUrl  String?
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version     ProjectVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  deployments Deployment[]

  @@unique([versionId, slug])
  @@index([projectId])
  @@index([versionId])
  @@index([isPublished])
  @@index([deletedAt])
  @@map("pages")
}

model Conversation {
  id        String    @id @default(cuid())
  userId    String
  projectId String?
  title     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project  Project?  @relation(fields: [projectId], references: [id])
  messages Message[]

  @@index([userId])
  @@index([projectId])
  @@map("conversations")
}

model Message {
  id                String   @id @default(cuid())
  conversationId    String
  role              ChatRole
  content           String
  producedVersionId String?
  model             String?
  inputTokens       Int?
  outputTokens      Int?
  createdAt         DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("messages")
}

model Deployment {
  id        String           @id @default(cuid())
  projectId String
  versionId String
  pageId    String?
  userId    String
  version   Int              @default(1)
  status    DeploymentStatus @default(QUEUED)

  subdomain    String
  customDomain String?
  liveUrl      String?

  buildLog        String?
  buildDurationMs Int?
  deployedAt      DateTime?
  failedAt        DateTime?
  failureReason   String?

  rolledBackAt     DateTime?
  rolledBackFromId String?

  r2BucketKey String?
  ogImageKey  String?
  assetsKey   String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectVersion ProjectVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  page           Page?          @relation(fields: [pageId], references: [id])
  user           User           @relation(fields: [userId], references: [id])

  @@index([projectId])
  @@index([versionId])
  @@index([pageId])
  @@index([userId])
  @@index([status])
  @@index([subdomain])
  @@index([deletedAt])
  @@map("deployments")
}

model CustomDomain {
  id        String       @id @default(cuid())
  projectId String       @unique
  domain    String       @unique
  status    DomainStatus @default(PENDING)

  cloudflareRecordId String?
  cnameTarget        String?
  verifiedAt         DateTime?
  lastCheckedAt      DateTime?
  failureReason      String?

  sslStatus    String?
  sslIssuedAt  DateTime?
  sslExpiresAt DateTime?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([domain])
  @@index([status])
  @@index([deletedAt])
  @@map("custom_domains")
}

model PipelineLog {
  id        String        @id @default(cuid())
  projectId String
  versionId String?
  scanId    String?
  jobId     String        @unique
  stage     PipelineStage @default(RETRIEVAL)
  status    String

  retrievalMs   Int?
  specialistsMs Int?
  critiqueMs    Int?
  refinementMs  Int?
  synthesisMs   Int?
  copyMs        Int?
  seoMs         Int?
  totalMs       Int?

  chunksRetrieved Int?
  lowConfidence   Boolean @default(false)

  colorScore      Float?
  typographyScore Float?
  animationScore  Float?
  domainsRefined  String[]

  errorMessage String?
  errorStage   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
  @@index([createdAt])
  @@map("pipeline_logs")
}

model ProjectAnalytics {
  id           String    @id @default(cuid())
  projectId    String    @unique
  totalViews   Int       @default(0)
  uniqueViews  Int       @default(0)
  totalDeploys Int       @default(0)
  lastViewedAt DateTime?

  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_analytics")
}

model PageAnalytics {
  id        String   @id @default(cuid())
  projectId String
  path      String
  date      DateTime

  views   Int @default(0)
  uniques Int @default(0)

  referrers Json?

  desktop Int @default(0)
  mobile  Int @default(0)
  tablet  Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, path, date])
  @@index([projectId])
  @@index([date])
  @@map("page_analytics")
}

model UsageLog {
  id        String  @id @default(cuid())
  userId    String
  action    String
  projectId String?
  meta      Json?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([userId, action])
  @@map("usage_logs")
}

model Waitlist {
  id         String    @id @default(cuid())
  email      String    @unique
  name       String?
  useCase    String?
  source     String?
  approved   Boolean   @default(false)
  approvedAt DateTime?

  createdAt DateTime @default(now())

  @@index([approved])
  @@map("waitlist")
}

model ResearchReport {
  id                  String           @id @default(cuid())
  projectId           String           @unique
  inputType           ProjectInputType @default(FROM_SCRATCH)
  sourceScanId        String?
  summary             String
  primaryColor        String
  secondaryColor      String
  accentColor         String
  colorPalette        Json
  colorRationale      String
  fontPrimary         String
  fontSecondary       String
  typographyRationale String
  layoutStyle         String
  layoutRationale     String
  imageStyle          String
  imageDirection      Json
  imageRationale      String
  animationStyle      String?
  targetAgeGroup      String?
  toneOfVoice         String?
  seoKeywords         Json?
  competitorInsights  Json?
  citations           Json
  confidenceScore     Float?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("research_reports")
}

model ResearchArticle {
  id            String           @id @default(cuid())
  slug          String           @unique
  title         String
  kind          ResearchKind     @default(ARTICLE)
  category      ResearchCategory @default(OTHER)
  summary       String
  sections      Json
  body          String
  coverImageUrl String?
  tags          String[]
  references    Json?
  isPublished   Boolean          @default(true)
  publishedAt   DateTime?
  viewCount     Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([kind])
  @@index([category])
  @@index([isPublished])
  @@map("research_articles")
}

model CompetitorScan {
  id               String     @id @default(cuid())
  userId           String
  projectId        String?
  sourceUrl        String
  scanType         ScanType   @default(COMPETITOR)
  status           ScanStatus @default(QUEUED)
  screenshotKey    String?
  rawHtmlKey       String?
  designTokens     Json?
  extractedContent Json?
  failureReason    String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id])

  @@index([userId])
  @@index([projectId])
  @@index([status])
  @@map("competitor_scans")
}
