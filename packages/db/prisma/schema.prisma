  GENERATING
  READY
  DEPLOYING
  LIVE
  FAILED
}

enum DeploymentStatus {
  QUEUED
  BUILDING
  UPLOADING
  DNS_PROVISIONING
  ACTIVATING
  LIVE
  FAILED
  ROLLED_BACK
