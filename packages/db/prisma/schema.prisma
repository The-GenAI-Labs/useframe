enum CopyFramework {
  AIDA
  PAS
  FAB
  PASTOR
}

enum SiteType {
  SINGLE_PAGE
  MULTI_PAGE
}

enum PageType {
  HOME
  ABOUT
  CONTACT
  PRICING
  PRODUCT
  RESEARCH
  DEMO
  BLOG
  FAQ
  CHANGELOG
}

enum CatalogStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum ResearchKind {
  ARTICLE
  CASE_STUDY
}

enum ResearchCategory {
  COLOR_PSYCHOLOGY
  TYPOGRAPHY
  SCREEN_TIME
  LAYOUT
  CONVERSION
  ACCESSIBILITY
  AGE_GROUP
  INDUSTRY
  OTHER
}

enum ScanType {
  COMPETITOR
  OWN_SITE
  REPLICATION_TARGET
  STYLE_REFERENCE
}

enum ScanStatus {
  QUEUED
  RENDERING
  EXTRACTING
  ANALYZING
  DONE
  FAILED
}

enum ProjectInputType {
  FROM_SCRATCH
  FROM_COMPETITOR
  FROM_OWN_SITE
}

model User {
  id        String     @id @default(cuid())
  name      String?
  avatarUrl String?
  status    UserStatus @default(ACTIVE)

  phone           String?   @unique // post-login verified attribute, NOT a login method
  phoneVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  hasUsedFreeGeneration Boolean   @default(false)
  freeReplicationUsed   Boolean   @default(false)
  freeReplicationUsedAt DateTime?

  razorpayCustomerId     String? @unique
  defaultPaymentMethodId String?

  // Attribution — captured client-side from ?ref / utm_* query params at
  // signup time only, never overwritten afterward.
  referralSource String?
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?

  // Versioned ToS/Privacy consent — acceptedTermsVersion lets us tell who
  // agreed to which revision if it's ever disputed. Bump the version string
  // (see TERMS_VERSION in auth.service.ts) whenever the ToS materially changes.
  acceptedTermsAt      DateTime?
  acceptedTermsVersion String?

  // Free-tier abuse risk, assessed once at signup completion (see
  // assessSignupRisk() in apps/server/src/security). Gates ONLY the free
  // generation grant in GenerateService.authorize() — never account
  // creation, never a permanent ban. "ALLOW" | "SUSPICIOUS" | "BLOCK_FREE_TIER".
  signupRiskDecision String?
  signupRiskScore    Int?

  identities       Identity[]
  sessions         Session[]
  refreshTokens    RefreshToken[]
  phoneOtps        PhoneOtp[]
  ticketTokens     TicketToken[]
  signupRiskEvents SignupRiskEvent[]

  subscription       Subscription?
  orders             Order[]
  payments           Payment[]
  creditBalance      CreditBalance?
  creditTransactions CreditTransaction[]
  autoReloadSetting  AutoReloadSetting?
  projects           Project[]
  conversations      Conversation[]
  deployments        Deployment[]
  usageLogs          UsageLog[]
  competitorScans    CompetitorScan[]
  scoreResults       ScoreResult[]
  seoAuditResults    SeoAuditResult[]
  replications       Replication[]
  projectBriefs      ProjectBrief[]
  briefUploads       BriefUpload[]

  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

// IDENTITY — one row per way of logging in, uniform across all three:
//   EMAIL  → externalId = the email address      (magic link)
//   GOOGLE → externalId = Google's user id (sub)  (OAuth)
//   GITHUB → externalId = GitHub's user id        (OAuth)
// `email` = the verified email tied to this identity; it's the key
// that makes "same email = same account" work. For EMAIL rows it
// equals externalId (that overlap is the price of full uniformity).

model Identity {
  id         String       @id @default(cuid())
  userId     String
  type       AuthProvider // EMAIL | GOOGLE | GITHUB
  externalId String // natural key within the type
  email      String // verified email for this identity - linking key
  isPrimary  Boolean      @default(false) // marks the user's contact email
  verifiedAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([type, externalId]) // a given Google/GitHub/email identity links once
  @@index([userId])
  @@index([email]) // fast "find account by this email" for linking
  @@map("identities")
}

model Session {
  id           String    @id @default(cuid())
  userId       String
  deviceName   String?
  userAgent    String?
  ip           String?
  lastActiveAt DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model RefreshToken {
  id        String    @id @default(cuid())
  sessionId String
  userId    String
  tokenHash String    @unique
  familyId  String
  parentId  String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  session  Session        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   RefreshToken?  @relation("TokenRotation", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children RefreshToken[] @relation("TokenRotation")

  @@index([userId])
  @@index([sessionId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model MagicLinkToken {
  id         String    @id @default(cuid())
  email      String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  // ToS consent is captured on the "confirm" step, before this token is
  // sent by email — the link is frequently opened in a different tab/device
  // than the one that requested it, so consent travels with the token
  // itself rather than relying on sessionStorage still being present when
  // the link is clicked.
  acceptedTerms  Boolean @default(false)
  referralSource String?
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?

  // Signup risk inputs, captured at request time for the same reason as
  // acceptedTerms above — the IP that matters for risk scoring is the one
  // that actually asked for the link, not whatever IP later clicks it.
  requestIp         String?
  deviceFingerprint String?

  @@index([email])
  @@index([expiresAt])
  @@map("magic_link_tokens")
}

model TicketToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("ticket_tokens")
}

// One row per completed signup's risk assessment (see assessSignupRisk()).
// Kept as an append-only log distinct from User.signupRiskDecision/Score
// (which only ever holds the latest) so risk-scoring changes over time
// stay auditable — e.g. if IPQS or the scoring weights change later.
model SignupRiskEvent {
  id                String   @id @default(cuid())
  userId            String
  email             String
  ipAddress         String
  deviceFingerprint String?
  riskScore         Int
  decision          String
  reasons           String[]
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([ipAddress, createdAt])
  @@index([deviceFingerprint, createdAt])
  @@map("signup_risk_events")
}

model PhoneOtp {
  id         String    @id @default(cuid())
  userId     String
  phone      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("phone_otps")
}

model Plan {
  id                        String   @id @default(cuid())
  name                      String
  slug                      String   @unique
  description               String?
  rank                      Int
  priceMonthly              Int      @default(0)
  priceYearly               Int      @default(0)
  currency                  String   @default("USD")
  creditAllowance           Int      @default(0)
  monthlyGenerationQuota    Int?
  requiresPhoneVerification Boolean  @default(false)
  features                  Json     @default("{}")
  isActive                  Boolean  @default(true)
  createdAt                 DateTime @default(now())

  orders        Order[]
  subscriptions Subscription[]

  @@map("plans")
}

model Order {
  id                String      @id @default(cuid())
  userId            String
  planId            String
  amount            Int
  currency          String      @default("USD")
  status            OrderStatus @default(PENDING)
  provider          String      @default("razorpay")
  providerSessionId String?     @unique
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan    Plan     @relation(fields: [planId], references: [id])
  payment Payment?

  @@index([userId])
  @@index([status])
  @@map("orders")
}

model Subscription {
  id                     String             @id @default(cuid())
  userId                 String             @unique
  planId                 String
  status                 SubscriptionStatus @default(ACTIVE)
  billingInterval        BillingInterval    @default(MONTHLY)
  currentPeriodStart     DateTime
  currentPeriodEnd       DateTime
  cancelAtPeriodEnd      Boolean            @default(false)
  providerSubscriptionId String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan     Plan      @relation(fields: [planId], references: [id])
  payments Payment[]

  @@index([planId])
  @@map("subscriptions")
}

model Payment {
  id                String         @id @default(cuid())
  orderId           String?        @unique
  userId            String
  purpose           PaymentPurpose
  subscriptionId    String?
  amount            Int
  currency          String         @default("USD")
  status            PaymentStatus  @default(PENDING)
  provider          String         @default("razorpay")
  providerOrderId   String         @unique
  providerPaymentId String?
  paymentMethod     String?
  capturedAt        DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  order              Order?              @relation(fields: [orderId], references: [id])
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription       Subscription?       @relation(fields: [subscriptionId], references: [id])
  creditTransactions CreditTransaction[]

  @@index([userId])
  @@map("payments")
}

model WebhookEvent {
  id          String    @id @default(cuid())
  eventId     String    @unique
  eventType   String
  provider    String    @default("razorpay")
  payload     Json
  processed   Boolean   @default(false)
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@map("webhook_events")
}

model CreditBalance {
  userId      String   @id
  balance     Int      @default(0)
  periodStart DateTime @default(now())
  periodEnd   DateTime
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("credit_balances")
}

model CreditTransaction {
  id           String        @id @default(cuid())
  userId       String
  delta        Int
  type         CreditTxnType
  reason       String
  balanceAfter Int
  refType      String?
  refId        String?
  paymentId    String?
  expiresAt    DateTime?
  createdAt    DateTime      @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment Payment? @relation(fields: [paymentId], references: [id])

  @@index([userId, createdAt])
  @@map("credit_transactions")
}

model AutoReloadSetting {
  userId         String   @id
  enabled        Boolean  @default(false)
  thresholdCents Int
  topUpToCents   Int
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auto_reload_settings")
}

enum ResearchDocumentType {
  COMPETITOR_ANALYSIS
  RESEARCH_RATIONALE
}

// A generated PDF research report. The bytes live here rather than in object
// storage: reports are small (~50-300KB) and there's no R2 upload path in
// this codebase yet. Swapping to object storage later means changing where
// `pdf` is read/written, not the surrounding flow.
model ResearchDocument {
  id          String               @id @default(cuid())
  projectId   String
  type        ResearchDocumentType
  title       String
  pdf         Bytes
  generatedAt DateTime             @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("research_documents")
}

model Project {
  id               String           @id @default(cuid())
  userId           String
  name             String
  slug             String           @unique
  startupIdea      String
  niche            NicheCategory    @default(OTHER)
  targetAudience   String
  brandPersonality String?
  pricePositioning String?
  businessModel    String?
  differentiator   String?
  status           ProjectStatus    @default(DRAFT)
  inputType        ProjectInputType @default(FROM_SCRATCH)
  // Which tier's generation actually built this project — resolved once by
  // GenerateService.authorize() at creation and stamped here so the
  // workspace UI (model-tier banner) can read it back reliably after a
  // reload, not just from the one-shot create response.
  generationTier   GenerationTier   @default(PAID)
  sourceUrl        String?
  docsKey          String?
  description      String?
  logoUrl          String?
  currentVersionId String?
  vercelProjectId  String?
  pinned           Boolean          @default(false)
  deletedAt        DateTime?
  archivedAt       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions        ProjectVersion[]
  pages           Page[]
  chatMessages    ProjectChatMessage[]
  conversations   Conversation[]
  deployments     Deployment[]
  customDomain    CustomDomain?
  site            ProjectSite?
  pipelineLogs    PipelineLog[]
  analytics       ProjectAnalytics?
  pageAnalytics   PageAnalytics[]
  researchReport  ResearchReport?
  researchIntake  ResearchIntake?
  pipelineState   PipelineState?
  competitorScans CompetitorScan[]
  researchDocs    ResearchDocument[]
  validationRuns  ValidationRun[]
  replication     Replication?
  brief           ProjectBrief?

  @@index([userId])
  @@index([status])
  @@index([deletedAt])
  @@index([userId, deletedAt])
  @@index([userId, pinned])
  @@map("projects")
}

model ProjectVersion {
  id                 String   @id @default(cuid())
  projectId          String
  versionNumber      Int
  label              String?
  siteType           SiteType @default(MULTI_PAGE)
  seo                Json     @default("{}")
  designBrief        Json?
  parentVersionId    String?
  createdByMessageId String?
  triggeredBy        String?
  validationFixKey   String?  @unique
  nextFiles          Json?
  snapshot           Json
  // Brief revision this version was generated from; older than the brief's
  // latest revision means the version is stale.
  briefRevisionId    String?
  createdAt          DateTime @default(now())

  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  briefRevision BriefRevision? @relation(fields: [briefRevisionId], references: [id], onDelete: SetNull)
  pages         Page[]
  deployments   Deployment[]

  validationRuns ValidationRun[]

  @@unique([projectId, versionNumber])
  @@index([projectId])
  @@map("project_versions")
}

model Page {
  id          String    @id @default(cuid())
  projectId   String
  versionId   String
  type        PageType  @default(HOME)
  slug        String
  title       String
  sections    Json
  seo         Json?
  ogImageUrl  String?
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version     ProjectVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  deployments Deployment[]

  @@unique([versionId, slug])
  @@index([projectId])
  @@index([versionId])
  @@index([isPublished])
  @@index([deletedAt])
  @@map("pages")
}

model Conversation {
  id            String    @id @default(cuid())
  userId        String
  projectId     String?
  replicationId String?
  title         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project?     @relation(fields: [projectId], references: [id])
  replication Replication? @relation(fields: [replicationId], references: [id])
  messages    Message[]

  @@index([userId])
  @@index([projectId])
  @@index([replicationId])
  @@map("conversations")
}

model Message {
  id                String   @id @default(cuid())
  conversationId    String
  role              ChatRole
  content           String
  producedVersionId String?
  model             String?
  inputTokens       Int?
  outputTokens      Int?
  // Array of { type: "pdf", documentId, title, url } — rendered inline in
  // chat history so a report stays reopenable by scrolling up rather than
  // being a one-time download link.
  attachments       Json?
  createdAt         DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("messages")
}

model Deployment {
  id        String           @id @default(cuid())
  projectId String
  versionId String
  pageId    String?
  userId    String
  version   Int              @default(1)
  status    DeploymentStatus @default(QUEUED)

  subdomain    String
  customDomain String?
  liveUrl      String?

  buildLog        String?
  buildDurationMs Int?
  deployedAt      DateTime?
  failedAt        DateTime?
  failureReason   String?

  rolledBackAt     DateTime?
  rolledBackFromId String?

  r2BucketKey String?
  ogImageKey  String?
  assetsKey   String?

  siteId         String?
  framework      SiteFramework?
  storagePrefix  String?
  fileCount      Int?
  totalBytes     BigInt?
  rootHtmlSha256 String?
  siteUrl        String?
  triggeredBy    String         @default("user")
  purgedAt       DateTime?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectVersion ProjectVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  page           Page?          @relation(fields: [pageId], references: [id])
  user           User           @relation(fields: [userId], references: [id])
  site           ProjectSite?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([versionId])
  @@index([pageId])
  @@index([userId])
  @@index([status])
  @@index([subdomain])
  @@index([deletedAt])
  @@index([siteId])
  @@index([projectId, status])
  @@map("deployments")
}

model ProjectSite {
  id                 String    @id @default(cuid())
  projectId          String    @unique
  subdomainLabel     String    @unique
  defaultHost        String    @unique
  primaryHost        String
  activeDeploymentId String?
  suspendedAt        DateTime?
  suspendedReason    String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deployments Deployment[]

  @@map("project_sites")
}

model CustomDomain {
  id        String       @id @default(cuid())
  projectId String       @unique
  domain    String       @unique
  status    DomainStatus @default(PENDING)

  cloudflareRecordId String?
  cnameTarget        String?
  verifiedAt         DateTime?
  lastCheckedAt      DateTime?
  failureReason      String?
  // Machine-readable failure; retryability is derived from it.
  failureCode        String?

  sslStatus    String?
  sslIssuedAt  DateTime?
  sslExpiresAt DateTime?

  ownershipToken      String?
  ownershipVerifiedAt DateTime?
  cfCustomHostnameId  String?   @unique
  cfHostnameStatus    String?
  isApex              Boolean   @default(false)
  retryCount          Int       @default(0)
  // When the current status was entered; the ownership/routing windows and Retry reset it.
  stateChangedAt      DateTime  @default(now())

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([domain])
  @@index([status])
  @@index([deletedAt])
  @@map("custom_domains")
}

model PipelineLog {
  id        String        @id @default(cuid())
  projectId String
  versionId String?
  scanId    String?
  jobId     String        @unique
  stage     PipelineStage @default(RETRIEVAL)
  status    String

  retrievalMs   Int?
  specialistsMs Int?
  critiqueMs    Int?
  refinementMs  Int?
  synthesisMs   Int?
  copyMs        Int?
  seoMs         Int?
  totalMs       Int?

  chunksRetrieved Int?
  lowConfidence   Boolean @default(false)

  colorScore      Float?
  typographyScore Float?
  animationScore  Float?
  domainsRefined  String[]

  errorMessage String?
  errorStage   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
  @@index([createdAt])
  @@map("pipeline_logs")
}

model ProjectAnalytics {
  id           String    @id @default(cuid())
  projectId    String    @unique
  totalViews   Int       @default(0)
  uniqueViews  Int       @default(0)
  totalDeploys Int       @default(0)
  lastViewedAt DateTime?

  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_analytics")
}

model PageAnalytics {
  id        String   @id @default(cuid())
  projectId String
  path      String
  date      DateTime

  views   Int @default(0)
  uniques Int @default(0)

  referrers Json?

  desktop Int @default(0)
  mobile  Int @default(0)
  tablet  Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, path, date])
  @@index([projectId])
  @@index([date])
  @@map("page_analytics")
}

model UsageLog {
