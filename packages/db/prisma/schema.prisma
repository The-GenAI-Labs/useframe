model ResearchFinding {
  id               String                       @id @default(cuid())
  claim            String                       @default("")
  paper            String                       @default("")
  field            String                       @default("")
  appliesTo        String[]
  audience         String[]
  decision         String                       @default("")
  options          Json                         @default("[]")
  contextHeader    String                       @default("")
  verified         Boolean                      @default(true)
  embedding        Unsupported("vector(1536)")?
  createdAt        DateTime                     @default(now())
  slug             String                       @unique
  status           FindingStatus                @default(DRAFT)
  category         ResearchCategory             @default(OTHER)
  title            String
  statement        String
  appliesWhen      String?
  tags             String[]
  confidenceScore  Float?
  effectSize       String?
  sourceDocumentId String?
  sourceExcerpt    String?
  sourceLocator    String?
  reuseCount       Int                          @default(0)
