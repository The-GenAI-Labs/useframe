generator client {
  provider        = "prisma-client"
  output              = "./generated"
  previewFeatures     = ["postgresqlExtensions"]
  // Compiled with tsc to dist/, so generated imports must use .js specifiers.
  importFileExtension = "js"
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

// Mirrors packages/schemas' TierEnum (z.enum(["free", "paid"])) — kept as
// its own Prisma enum (rather than reusing a shared string) so Project rows
// get DB-level validation on this field.
enum GenerationTier {
  FREE
  PAID
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  EXPIRED
}

enum PaymentPurpose {
  SUBSCRIPTION
  CREDIT_TOPUP
}

enum CreditTxnType {
  RECURRING_GRANT
  PURCHASED
  SPEND
  REFUND
  ADJUSTMENT
}

enum ChatRole {
  USER
  ASSISTANT
  SYSTEM
}

enum ProjectStatus {
