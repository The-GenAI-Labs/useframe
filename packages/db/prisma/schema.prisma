  @@index([status])
  @@index([category])
  @@index([field])
  @@index([decision])
  @@map("research_findings")
}

model FindingRelation {
  id               String              @id @default(cuid())
  findingId        String              @map("fromId")
  relatedFindingId String              @map("toId")
  relationType     FindingRelationType
  legacyRelation   String              @default("") @map("relation")
  note             String?
  createdAt        DateTime            @default(now())
  finding          ResearchFinding     @relation("RelationFrom", fields: [findingId], references: [id], onDelete: Cascade)
  relatedFinding   ResearchFinding     @relation("RelationTo", fields: [relatedFindingId], references: [id], onDelete: Cascade)

  @@unique([findingId, relatedFindingId, relationType])
  @@index([relatedFindingId])
  @@map("finding_relations")
}

