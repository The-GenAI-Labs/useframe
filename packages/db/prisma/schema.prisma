  updatedAt        DateTime                     @updatedAt
  source           SourceDocument?              @relation(fields: [sourceDocumentId], references: [id])
  chunks           FindingChunk[]
  relationsFrom    FindingRelation[]            @relation("RelationFrom")
  relationsTo      FindingRelation[]            @relation("RelationTo")
