  GITHUB
  EMAIL
}

enum DomainStatus {
  PENDING
  VERIFYING
  ACTIVE
  FAILED
  AWAITING_OWNERSHIP_TXT
  CONFIGURING_EDGE
  AWAITING_ROUTING_DNS
  REMOVING
