// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`rendering > renders a muted background video started by the playback script 1`] = `"<video muted playsInline preload="metadata" poster={"https://api.test/media/v1/poster?sig=1"} loop data-uf-play={"load"} aria-hidden="true" style={{"display":"block","width":"100%","objectFit":"cover","objectPosition":"center","backgroundColor":"#334455","position":"absolute","inset":0,"height":"100%","zIndex":0}}><source src={"https://api.test/media/v1/mp4_720?sig=1"} type="video/mp4" media="(max-width: 767px)" /><source src={"https://api.test/media/v1/mp4_1080?sig=1"} type="video/mp4" /></video>"`;

exports[`rendering > renders a player with controls and no preload 1`] = `"<video controls preload="none" playsInline poster={"https://api.test/media/v1/poster?sig=1"} title={"A bright office"} aria-label={"A bright office"} style={{"display":"block","width":"100%","objectFit":"cover","objectPosition":"center","backgroundColor":"#334455","height":"auto","borderRadius":"var(--radius)"}}><source src={"https://api.test/media/v1/mp4_720?sig=1"} type="video/mp4" media="(max-width: 767px)" /><source src={"https://api.test/media/v1/mp4_1080?sig=1"} type="video/mp4" /></video>"`;

exports[`rendering > renders a responsive, eager hero <picture> with explicit dimensions 1`] = `"<picture><source type="image/webp" srcSet={"https://api.test/media/img1/w480?sig=1 480w, https://api.test/media/img1/w960?sig=1 960w, https://api.test/media/img1/w1600?sig=1 1600w"} sizes={"(min-width: 1024px) 960px, 100vw"} /><img src={"https://api.test/media/img1/fallback?sig=1"} width={1600} height={900} alt={"A bright office"} decoding="async" loading="eager" fetchpriority="high" style={{"display":"block","width":"100%","objectFit":"cover","objectPosition":"center","backgroundColor":"#334455","height":"auto","borderRadius":"var(--radius)","aspectRatio":"16 / 9"}} /></picture>"`;

exports[`rendering > renders an inline step clip that plays in view, once, with an accessible label 1`] = `"<video muted playsInline preload="metadata" poster={"https://api.test/media/v1/poster?sig=1"} data-uf-play={"in_view"} title={"A bright office"} aria-label={"A bright office"} style={{"display":"block","width":"100%","objectFit":"cover","objectPosition":"center","backgroundColor":"#334455","height":"auto","borderRadius":"var(--radius)","aspectRatio":"16 / 9"}}><source src={"https://api.test/media/v1/mp4_720?sig=1"} type="video/mp4" media="(max-width: 767px)" /><source src={"https://api.test/media/v1/mp4_1080?sig=1"} type="video/mp4" /></video>"`;
