# Build output and dependencies (rebuilt inside the image)
**/node_modules
**/dist
**/.next
**/.turbo
**/.wrangler
**/coverage
**/*.tsbuildinfo
**/*.log

# Secrets and credentials: never in a build context
**/.env
**/.env.*
!**/.env.example
**/*.pem
**/*.key
**/id_rsa*
**/.terraform
**/*.tfstate*
**/terraform.tfvars

# Not part of any image
.git
.github
.vscode
.idea
**/.DS_Store
**/Thumbs.db
docs
infra
**/*.md
apps/worker/snapshots

# Apps without an image: keep only their manifests (the frozen lockfile validates every workspace package)
apps/web/*
!apps/web/package.json
apps/site-edge/*
!apps/site-edge/package.json
